---
import Layout from "../components/Layout.astro";
import FeaturedCarousel from "../components/FeaturedCarousel.astro";
import MasonryGridPlusFiller from "../components/MasonryGridPlusFiller.astro";
import { getCollection } from "astro:content";
import { getProjectImage } from "../utils/imageLoader";


const projects = await getCollection('projects', ({ data }) => {
  return data.draft !== true;
});

projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Carousel | je sépare les projets à la une
const featuredProjects = projects.filter(p => p.data.featured);
const regularProjects = projects.filter(p => !p.data.featured);

// Trier les featured par ordre si défini
featuredProjects.sort((a, b) => {
  const orderA = a.data.featuredOrder || 999;
  const orderB = b.data.featuredOrder || 999;
  return orderA - orderB;
});

// Charger les thumbnails pour les projets featured
const featuredWithImages = await Promise.all(
  featuredProjects.map(async (project) => ({
    slug: project.slug,
    data: {
      ...project.data,
      heroImage: await getProjectImage(project, project.data.hero)
    }
  }))
);


// console.log('Nombre de projets trouvés:', projects.length);
// console.log('Liste des slugs:', projects.map(p => p.slug));

// ✅ NEW Utilise la fonction utilitaire
// Les seuls champs utilisés pour la home :
const projectsWithThumbnails = await Promise.all(
  projects.map(async (project) => ({
    slug: project.slug,
    data: {
      title: project.data.title,
      categories: project.data.categories,
      couleur: project.data.couleur,
      gridSize: project.data.gridSize, // ← Taille de la carte
      thumbnailImage: await getProjectImage(project, project.data.thumbnail), // ← Image
      thumbnail_alt: project.data.thumbnail_alt,
    }
  }))
);

// console.log("✅ Projets chargés:", projectsWithThumbnails.length);
---

<Layout title="Portfolio">
  {/* Carousel des projets à la une */}
    {featuredWithImages.length > 0 && (
      <FeaturedCarousel projects={featuredWithImages} />
    )}
<div class="container">
    <header class="hero">
      <h1>Portfolio</h1>
      <p>Design graphique & Développement web</p>
    </header>
  </div>
  <div class="container--max">
    <MasonryGridPlusFiller projects={projectsWithThumbnails} />
  </div>
</Layout>

