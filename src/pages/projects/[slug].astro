---
import { getCollection } from "astro:content";

import { Image } from "astro:assets";
import Layout from "../../components/Layout.astro";
import { getProjectImage, getProjectImages } from "../../utils/imageLoader"; // ← Import
import { marked } from "marked"; // Pour parser le markdown dans 'text'

// Components
import OptimizedImage from "../../components/OptimizedImage.astro";
import HeroBanner from "../../components/projects/HeroBanner.astro";
import Objectifs from "../../components/projects/Objectifs.astro";
import BeforeAfter from "../../components/projects/BeforeAfter.astro";
import Slider from "../../components/projects/Slider";
import Links from "../../components/projects/Links.astro";
import BeforeAfterFirst from "../../components/projects/BeforeAfterFirst.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const data = project.data || {};
const { title, description, couleur, slug, projectFolder, hero, elements } =
  data;

console.log("🔍 Slug:", project.slug);
// console.log("🔍 ProjectFolder:", project.data.projectFolder);
// console.log("🔍 Hero:", project.data.hero);

// === CHARGER TOUTES LES IMAGES ===
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*.{jpg,jpeg,png,webp,avif}",
);

// console.log("Toutes les images trouvées", Object.keys(allImages));

// === FONCTION POUR CHARGER UNE IMAGE ===
async function getImage(filename: string) {
  const folder = project.data.projectFolder || project.slug;

  // Construire le chemin EXACT
  const path = `/src/assets/projects/${folder}/${filename}`;

  // console.log(`🖼️  Recherche de: ${filename}`);
  // console.log(`📍 Chemin construit: ${path}`);

  // Chercher l'image
  const imageLoader = allImages[path];

  if (!imageLoader) {
    console.error(`❌ Image NON TROUVÉE: ${path}`);
    console.log("💡 Vérifiez que le fichier existe à cet emplacement exact");
    return null;
  }
  // Charger l'image
  try {
    const module = await imageLoader();
    return module.default;
  } catch (error) {
    console.error(`❌ Erreur lors du chargement de ${path}:`, error);
    return null;
  }
}

// Fonctions utilitaires
const heroImage = await getProjectImage(project, project.data.hero);
const thumbnailImage = await getProjectImage(project, project.data.thumbnail);

// Slider
const sliderImages = project.data.slider
  ? await getProjectImages(project, project.data.slider) // ← Fonction multiple
  : [];

// Charger les rangées
const projectRows = project.data.rows
  ? await Promise.all(
      project.data.rows.map(async (row, rowIndex) => ({
        elements: await Promise.all(
          row.elements.map(async (element, elementIndex) => {
            const baseDelay = rowIndex * 0.3 + elementIndex * 0.15;

            if (element.type === "image") {
              return {
                type: "image",
                image: await getProjectImage(project, element.src),
                alt: element.alt || "",
                gridColumn: element.gridColumn,
              };
            }

            if (element.type === "objectives") {
              return {
                type: "objectives",
                gridColumn: element.gridColumn,
                items: element.items,
              };
            }

            if (element.type === "text") {
              return {
                type: "text",
                gridColumn: element.gridColumn,
                content: element.content,
              };
            }
            // Type 4 : Before-After
            if (element.type === "before-after") {
              // ✅ CORRECTION : Charger les deux images
              const beforeImage = await getProjectImage(
                project,
                element.beforeSrc,
              );
              const afterImage = await getProjectImage(
                project,
                element.afterSrc,
              );

              // Vérifier que les deux images sont chargées
              if (!beforeImage || !afterImage) {
                console.error("❌ Before-After images manquantes:", {
                  before: element.beforeSrc,
                  after: element.afterSrc,
                });
                return null; // Skip cet élément
              }

              return {
                type: "before-after",
                gridColumn: element.gridColumn,
                beforeImage,
                afterImage,
                label: element.label,
                alt: element.alt || "",
              };
            }

            return null;
          }),
        ).then((elements) => elements.filter(Boolean)),
      })),
    )
  : [];

// console.log("=== DEBUG PROJECT ===");
// console.log("project.slug:", project.slug);
// console.log("project.data:", project.data);
// console.log("heroImage:", heroImage);
// console.log("=====================");

const { Content } = await project.render();
---

<Layout title={project.data.title}>
  <article
    class="project-page"
    style={`--project-color: ${couleur || "#3085a3"}`}
    aria-label={title}
    data-scroll-animate
  >
    {/* === HERO PLEINE HAUTEUR === */}
    {
      heroImage && (
        <section class="hero-fullscreen">
          <div class="hero-image">
            <Image
              src={heroImage}
              alt={project.data.title}
              widths={[1200, 1600, 2000, 2400]}
              formats={["avif", "webp", "jpg"]}
              loading="eager"
              quality={90}
            />
          </div>
          <div class="hero-overlay">
            <div class="hero-content">
              <h1 class="hero-title">{project.data.title}</h1>
              <p class="hero-categories">
                {project.data.categories.join(" • ")}
              </p>
            </div>
          </div>
          <div class="scroll-indicator">
            <span>Défiler</span>
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M12 5v14M19 12l-7 7-7-7" />
            </svg>
          </div>
        </section>
      )
    }

    <section class="project-intro" data-scroll-animate>
      <div class="container-narrow">
        <Content />
      </div>
    </section>
    <main class="container">
      {
        projectRows.map((row, rowIndex) => (
          <section class="row-grid">
            {row.elements.map((element, index) => {
              // === IMAGE ===
              if (element.type === "image" && element.image) {
                return (
                  <div
                    class="row-element element-image"
                    data-scroll-animate
                    data-parallax-content
                    style={`
                    --grid-column: ${element.gridColumn};
                    --delay: ${(index % 10) * 0.1}s;
                  `}
                  >
                    <Image
                      src={element.image}
                      alt={element.alt}
                      widths={[600, 900, 1200, 1600]}
                      formats={["avif", "webp", "jpg"]}
                      loading="lazy"
                      quality={85}
                    />
                  </div>
                );
              }

              // === OBJECTIFS ===
              if (element.type === "objectives") {
                return (
                  <div
                    class="row-element element-objectives"
                    data-scroll-animate
                    style={`
                    --grid-column: ${element.gridColumn};
                    --delay: ${(index % 10) * 0.2}s;
                  `}
                  >
                    <div class="element-wrapper" data-parallax-content>
                      <h3>Objectifs</h3>
                      <ul>
                        {element.items.map((item, index) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                );
              }

              // === TEXTE LIBRE ===
              if (element.type === "text") {
                return (
                  <div
                    class="row-element element-text"
                    data-scroll-animate
                    style={`
                    --grid-column: ${element.gridColumn};
                    --delay: ${(index % 10) * 0.1}s;
                  `}
                  >
                    <div class="element-wrapper" data-parallax-content>
                      <div set:html={marked.parse(element.content)} />
                    </div>
                  </div>
                );
              }
              // === BEFORE-AFTER ===
              if (
                element.type === "before-after" &&
                element.beforeImage &&
                element.afterImage
              ) {
                return (
                  <div
                    class="row-element element-before-after"
                    data-scroll-animate
                    style={`
        --grid-column: ${element.gridColumn};
        --delay: ${element.delay}s;
      `}
                  >
                    <BeforeAfter
                      before={element.beforeImage}
                      after={element.afterImage}
                      alt={element.alt}
                      label={element.label}
                    />
                  </div>
                );
              }

              return null;
            })}
          </section>
        ))
      }
    </main>
  </article>
</Layout>
