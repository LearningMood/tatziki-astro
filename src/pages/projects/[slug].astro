---
import { getCollection } from "astro:content";

import { Image } from "astro:assets";
import Layout from "@/components/Layout.astro";
import { getProjectImage, getProjectImages } from "@/utils/imageLoader"; // ← Import
import { marked } from "marked";

import Objectifs from "@/components/projects/Objectifs.astro";
import BeforeAfter from "@/components/projects/BeforeAfter.astro";
import Slider from "@/components/projects/Slider";
import Links from "@/components/projects/Links.astro";
import Hero from "@/components/projects/Hero.astro";
import ProjectNavigation from "@/components/projects/ProjectNavigation.astro";


// 2. getStaticPaths() - TOUJOURS EN PREMIER
export async function getStaticPaths() { //fonction spéciale qui s'exécute au moment du build, pas au moment du rendu de la page
  const projects = await getCollection("projects", ({ data }) => {
    return data.draft !== true;  // ← Filtre aussi ici
  });
  
  projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()); // par date
  
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { 
      project,
// Boucle circulaire
    prevProject: projects[index - 1] || projects[projects.length - 1],
    nextProject: projects[index + 1] || projects[0],
    }
  }));
}
// ⚠️ FIN DE LA FONCTION - Toutes les variables locales sont détruites
// prevProject et nextProject existent seulement dans l'objet props retourné. Les variables locales prevProject et nextProject n'existent plus.

// 3. RÉCUPÉRATION DES PROPS
const { project, prevProject, nextProject } = Astro.props;

// 4. DESTRUCTURATION DES DONNÉES
const { 
  title, 
  couleur, 
  slug, 
  projectFolder, 
  thumbnail, 
  hero, 
  categories, 
  links 
} = project.data;


// console.log("🔍 Slug:", project.slug);
// console.log("🔍 ProjectFolder:", project.data.projectFolder);
// console.log("🔍 Hero:", project.data.hero);

// 5. CHARGEMENT DES IMAGES
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*.{jpg,jpeg,png,webp,avif}",
);

// console.log("Toutes les images trouvées", Object.keys(allImages));

// === FONCTION POUR CHARGER UNE IMAGE ===
async function getImage(filename: string) {
  const folder = projectFolder || slug;

  // Construire le chemin EXACT
  const path = `/src/assets/projects/${folder}/${filename}`;

  // console.log(`🖼️  Recherche de: ${filename}`);
  // console.log(`📍 Chemin construit: ${path}`);

  // Chercher l'image
  const imageLoader = allImages[path];

  if (!imageLoader) {
    console.error(`❌ Image NON TROUVÉE: ${path}`);
    return null;
  }
  // Charger l'image
  try {
    const module = await imageLoader();
    return module.default;
  } catch (error) {
    console.error(`❌ Erreur lors du chargement de ${path}:`, error);
    return null;
  }
}

// Fonctions utilitaires
const heroImage = await getProjectImage(project, hero);
const thumbnailImage = await getProjectImage(project, thumbnail);

const prevThumbnail = prevProject 
  ? await getProjectImage(prevProject, prevProject.data.thumbnail)
  : null;
const nextThumbnail = nextProject 
  ? await getProjectImage(nextProject, nextProject.data.thumbnail)
  : null;

// Slider
const sliderImages = project.data.slider
  ? await getProjectImages(project, project.data.slider) // ← Fonction multiple
  : [];

// 6. TRAITEMENT DES RANGÉES
const projectRows = project.data.rows
  ? await Promise.all(
      project.data.rows.map(async (row, rowIndex) => ({
        elements: await Promise.all(
          row.elements.map(async (element, elementIndex) => {
            const baseDelay = rowIndex * 0.3 + elementIndex * 0.15;

            if (element.type === "image") {
              return {
                type: "image",
                image: await getProjectImage(project, element.src),
                alt: element.alt || "",
                gridColumn: element.gridColumn,
              };
            }

            if (element.type === "objectives") {
              return {
                type: "objectives",
                gridColumn: element.gridColumn,
                items: element.items,
              };
            }

            if (element.type === "text") {
              return {
                type: "text",
                gridColumn: element.gridColumn,
                content: element.content,
              };
            }
            // Type 4 : Before-After
            if (element.type === "before-after") {
              // ✅ CORRECTION : Charger les deux images
              const beforeImage = await getProjectImage(
                project,
                element.beforeSrc,
              );
              const afterImage = await getProjectImage(
                project,
                element.afterSrc,
              );

              // Vérifier que les deux images sont chargées
              if (!beforeImage || !afterImage) {
                console.error("❌ Before-After images manquantes:", {
                  before: element.beforeSrc,
                  after: element.afterSrc,
                });
                return null; // Skip cet élément
              }

              return {
                type: "before-after",
                gridColumn: element.gridColumn,
                beforeImage,
                afterImage,
                label: element.label,
                alt: element.alt || "",
              };
            }

            return null;
          }),
        ).then((elements) => elements.filter(Boolean)),
      })),
    )
  : [];

// console.log("=== DEBUG PROJECT ===");
// console.log("project.slug:", project.slug);
// console.log("project.data:", project.data);
// console.log("heroImage:", heroImage);
// console.log("=====================");
// 7. RENDER DU CONTENU MARKDOWN
const { Content } = await project.render();
---

<Layout title={project.data.title}>
  <article
    class="project-page"
    style={`--project-color: ${couleur || "#3085a3"}`}
    aria-label={title}
    data-scroll-animate
  >
    { heroImage && (
        <Hero
          imgSrc={heroImage}
          title={title}
          caegories={categories}
          showScrollIndicator={true}
        />
      )}

    <section class="projet-intro" data-scroll-animate>
      <div class="container--narrow">
          <Content />
      </div>
    </section>
    <main class="container--max">
      { projectRows.map((row, rowIndex) => (
          <section class="row-grid">
            {row.elements.map((element, index) => {
              // === IMAGE ===
              if (element.type === "image" && element.image) {
                return (
                  <div
                    class="row-element element-image"
                    data-scroll-animate
                    data-parallax-content
                    style={`
                    --grid-column: ${element.gridColumn};
                    --delay: ${(index % 10) * 0.1}s;
                  `}
                  >
                    <Image
                      src={element.image}
                      alt={element.alt}
                      widths={[600, 900, 1200, 1600]}
                      formats={["avif", "webp", "jpg"]}
                      loading="lazy"
                      quality={85}
                    />
                  </div>
                );
              }

              // === OBJECTIFS ===
              if (element.type === "objectives") {
                return (
                  <div
                    class="row-element element-obj"
                    data-scroll-animate
                    style={`
                    --grid-column: ${element.gridColumn};
                    --delay: ${(index % 10) * 0.2}s;
                  `}
                  >
                    <div class="element-wrapper" data-parallax-content>
                      <h2>Objectifs</h2>
                      <ul>
                        {element.items.map((item, index) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                );
              }

              // === TEXTE LIBRE ===
              if (element.type === "text") {
                return (
                  <div
                    class="row-element element-text"
                    data-scroll-animate
                    style={`
                    --grid-column: ${element.gridColumn};
                    --delay: ${(index % 10) * 0.1}s;
                  `}
                  >
                    <div class="element-wrapper" data-parallax-content>
                      <div set:html={marked.parse(element.content)} />
                    </div>
                  </div>
                );
              }
              // === BEFORE-AFTER ===
              if (
                element.type === "before-after" &&
                element.beforeImage &&
                element.afterImage
              ) {
                return (
                  <div
                    class="row-element element-before-after"
                    data-scroll-animate
                    style={`
                      --grid-column: ${element.gridColumn};
                      --delay: ${element.delay}s;
                    `}
                  >
                    <BeforeAfter
                      before={element.beforeImage}
                      after={element.afterImage}
                      alt={element.alt}
                      label={element.label}
                    />
                  </div>
                );
              }

              return null;
            })}
          </section>
         
        ))
      }
    </main>
            <!-- {
              links && <a href={links} >Un lien</a>
            } -->
  </article>


      <ProjectNavigation 
        prevProject={prevProject}
        nextProject={nextProject}
        prevThumbnail={prevThumbnail}
        nextThumbnail={nextThumbnail}

      />
</Layout>

