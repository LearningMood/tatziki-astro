---
import { getCollection } from "astro:content";

import { Image } from "astro:assets";
import Layout from "../../components/Layout.astro";
import { getProjectImage, getProjectImages } from "../../utils/imageLoader"; // ← Import

// Components
import OptimizedImage from "../../components/OptimizedImage.astro";
import HeroBanner from "../../components/projects/HeroBanner.astro";
import Objectifs from "../../components/projects/Objectifs.astro";
import BeforeAfter from "../../components/projects/BeforeAfter.astro";
import Slider from "../../components/projects/Slider";
import Links from "../../components/projects/Links.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const data = project.data || {};
const { title, description, couleur, slug, projectFolder, hero, gallery } = data;

// === DEBUG : Affiche les valeurs ===
console.log("🔍 Slug:", project.slug);
console.log("🔍 ProjectFolder:", project.data.projectFolder);
console.log("🔍 Hero:", project.data.hero);

// === CHARGER TOUTES LES IMAGES ===
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*.{jpg,jpeg,png,webp,avif}",
);

// === DEBUG : Affiche toutes les images trouvées ===
console.log("📂 Images disponibles:", Object.keys(allImages));

// === FONCTION POUR CHARGER UNE IMAGE ===
async function getImage(filename: string) {
  // ✅ Utilise projectFolder en priorité, sinon slug
  const folder = project.data.projectFolder || project.slug;

  // Construire le chemin EXACT
  const path = `/src/assets/projects/${folder}/${filename}`;

  // === DEBUG ===
  console.log(`🖼️  Recherche de: ${filename}`);
  console.log(`📍 Chemin construit: ${path}`);

  // Chercher l'image
  const imageLoader = allImages[path];

  if (!imageLoader) {
    console.error(`❌ Image NON TROUVÉE: ${path}`);
    console.log("💡 Vérifiez que le fichier existe à cet emplacement exact");
    return null;
  }

  console.log(`✅ Image trouvée: ${path}`);

  // Charger l'image
  try {
    const module = await imageLoader();
    return module.default;
  } catch (error) {
    console.error(`❌ Erreur lors du chargement de ${path}:`, error);
    return null;
  }
}

// ✅ Utilise les fonctions utilitaires - beaucoup plus simple !
const heroImage = await getProjectImage(project, project.data.hero);
const thumbnailImage = await getProjectImage(project, project.data.thumbnail);

// Charger les images de la grille
const galleryItems = gallery
  ? await Promise.all(
      gallery.map(async (item, index) => {
        // Si c'est un objectif (texte)
        if (item.type === 'objectives') {
          return {
            type: 'objectives',
            gridColumn: item.gridColumn || '1 / span 5',
            gridRow: item.gridRow,              // ← NOUVEAU
            marginTop: item.marginTop || 0,
            parallax: item.parallax || 0,
            items: item.items,
            zIndex: item.zIndex,                // ← NOUVEAU
            delay: item.delay ?? index * 0.15,
          };
        }
        
        // Si c'est une image
        return {
          type: 'image',
          image: await getProjectImage(project, item.src),
          alt: item.alt || '',
          gridColumn: item.gridColumn || '1 / span 14',
          marginTop: item.marginTop || 0,
          parallax: item.parallax || 0,
          delay: index * 0.1,
        };
      })
    )
  : [];

// Before/After
const beforeAfterData = project.data.beforeAfter
  ? Array.isArray(project.data.beforeAfter)
    ? project.data.beforeAfter
    : [project.data.beforeAfter]
  : [];

const beforeAfterPairs = await Promise.all(
  beforeAfterData.map(async (pair) => ({
    before: await getProjectImage(project, pair.before),
    after: await getProjectImage(project, pair.after),
    label: pair.label || "",
  })),
);

// Slider
const sliderImages = project.data.slider
  ? await getProjectImages(project, project.data.slider) // ← Fonction multiple
  : [];

// DEBUG : Affiche TOUT
console.log("=== DEBUG PROJECT ===");
console.log("project.slug:", project.slug);
console.log("project.data:", project.data);
console.log("heroImage:", heroImage);
console.log("=====================");

const { Content } = await project.render();
---

<Layout title={project.data.title}>
  <article
    class="project-page"
    style={`--project-color: ${couleur || "#3085a3"}`}
    aria-label={title}
    data-scroll-animate
  >
    {/* === HERO PLEINE HAUTEUR === */}
    {
      heroImage && (
        <section class="hero-fullscreen">
          <div class="hero-image">
            <Image
              src={heroImage}
              alt={project.data.title}
              widths={[1200, 1600, 2000, 2400]}
              formats={["avif", "webp", "jpg"]}
              loading="eager"
              quality={90}
            />
          </div>
          <div class="hero-overlay">
            <div class="hero-content">
              <h1 class="hero-title">{project.data.title}</h1>
              <p class="hero-categories">
                {project.data.categories.join(" • ")}
              </p>
            </div>
          </div>
          <div class="scroll-indicator">
            <span>Défiler</span>
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M12 5v14M19 12l-7 7-7-7" />
            </svg>
          </div>
        </section>
      )
    }

    {/* === INTRODUCTION === */}
    <section class="project-intro" data-scroll-animate>
      <div class="container-narrow">
        <Content />
      </div>
    </section>


    {/* === GALERIE 14 COLONNES === */}
    <section class="project-gallery-grid">
      {galleryItems.map((item) => {
        
        // === BLOC OBJECTIFS (TEXTE) ===
        if (item.type === 'objectives') {
          return (
            <div
              class="gallery-item objectives-block"
              data-scroll-animate
              data-parallax={item.parallax}
              style={`
                --grid-column: ${item.gridColumn};
                --margin-top: ${item.marginTop}px;
                --parallax-amplitude: ${item.parallax}px;
                --delay: ${item.delay}s;
              `}
            >
              <div class="objectives-content" data-parallax-content>
                <h3>Objectifs</h3>
                <ul>
                  {item.items.map((objective) => (
                    <li>{objective}</li>
                  ))}
                </ul>
              </div>
            </div>
          );
        }
        
        // === BLOC IMAGE ===
        if (item.type === 'image' && item.image) {
          return (
            <div
              class="gallery-item image-block"
              data-scroll-animate
              data-parallax={item.parallax}
              style={`
                --grid-column: ${item.gridColumn};
                --margin-top: ${item.marginTop}px;
                --parallax-amplitude: ${item.parallax}px;
                --delay: ${item.delay}s;
              `}
            >
              <div class="image-wrapper" data-parallax-content>
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[600, 900, 1200, 1600]}
                  formats={['avif', 'webp', 'jpg']}
                  loading="lazy"
                  quality={85}
                />
              </div>
            </div>
          );
        }
        
        return null;
      })}
    </section>

  </article>
</Layout>

