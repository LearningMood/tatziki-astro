---
const { project } = Astro.props;
const { Content } = await project.render();
const data = project.data || {};

import Layout from "../../components/Layout.astro";
// components
import HeroBanner from "../../components/projects/HeroBanner.astro";
import Objectifs from "../../components/projects/Objectifs.astro";
import BeforeAfter from "../../components/projects/BeforeAfter.astro";
import Slider from "../../components/projects/Slider";
import Links from "../../components/projects/Links.astro";

// import ProjectGrid from '../../components/projects/ProjectGrid.astro';

import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const {
  title,
  description,
  thumbnail,
  categories,
  couleur,
  hero,
  images = [],
  objectifs = [],
  beforeAfter,
  showSlider,
  links,
  componentsOrder = ["hero", "content"],
} = data;

// helper safe
function hasImages(arr) {
  return Array.isArray(arr) && arr.length > 0;
}
---

<Layout title={title} description={description}>
  <article
    class="project-page"
    style={`--project-color: ${couleur || "#F0F"}`}
    aria-label={title}
  >
    <nav class="breadcrumb">
      <a href="/">Accueil</a> / <a href="/projects">Portfolio</a> / <span
        >{title}</span
      >
    </nav>

    {
      componentsOrder.map((key) => {
        switch (key) {
          case "hero":
            // render hero only if banner or at least one image
            return HeroBanner || hasImages(images) ? (
              <HeroBanner
                image={hero || images[0].src}
                title={title}
                categories={categories}
                description={description}
              />
            ) : null;

          case "objectifs":
            return objectifs && objectifs.length ? (
              <Objectifs objectifs={objectifs} />
            ) : null;

          case "beforeAfter":
            // beforeAfter peut être un objet {before, after} dans le frontmatter
            return beforeAfter && beforeAfter.before && beforeAfter.after ? (
              /* lazy-load car souvent lourd */ <BeforeAfter
                client:visible
                before={beforeAfter.before}
                after={beforeAfter.after}
                alt={title}
                // alt="Transformation du design"
              />
            ) : null;

          case "slider":
            // soit frontmatter (images[]) soit showSlider flag
            return showSlider && hasImages(images) ? (
              <Slider
                images={[
                  {
                    src: "/projets/areva/slide1.jpg",
                    alt: "Slide 1",
                    caption: "Première étape",
                  },
                  {
                    src: "/projets/areva/slide2.jpg",
                    alt: "Slide 2",
                    caption: "Développement",
                  },
                  {
                    src: "/projets/areva/slide3.jpg",
                    alt: "Slide 3",
                    caption: "Résultat final",
                  },
                ]}
                autoplay={true}
                duration={4000}
                showThumbs={true}
                client:visible
                client:visible
                images={images}
              />
            ) : null;

          case "links":
            return links ? <Links href={links} /> : null;

          case "content":
          default:
            // contenu MDX/Markdown (le corps du fichier)
            return (
              <section class="project-body">
                <Content />
              </section>
            );
        }
      })
    }


    <main class="projet-content">
      <Content />
    </main>
  </article>
</Layout>

