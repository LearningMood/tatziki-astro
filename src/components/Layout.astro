---
import { ACTION_ERROR_CODES } from "astro:actions";
import "../styles/global.scss"; // ← Chemin relatif depuis le Layout
import ScrollAnimator from "./projects/ScrollAnimator.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio Tatziki" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Tatziki</title>
    <!-- <link rel="stylesheet" href="/src/styles/global.scss"> -->
  </head>
  <body>
    <nav class="main-nav">
      <div class="logo-tatziki">
        <a href="/">Accueil</a>
      </div>
      <div class="main-nav-menu">
        <a href="/about">À propos</a>
      </div>
    </nav>

    <>
      <slot />
    </>

    <footer>
      <div class="container--max">
        <aside class="footer-infos">
          <div class="col col--contact">
            <p>© {new Date().getFullYear()} Charlotte Casters | Tatziki</p>
            <h4>Contact</h4>
            <p>Charlotte Casters</p>
            <p>
              Directrice artistique - UX & Web designer - Animatrice &
              conceptrice de formations
            </p>
            <ul>
              <li><a href="">Télécharger mon CV contact@tatziki.com</a></li>
              <li>
                <a href=""
                  >lien Profil Linkedin Charlotte Casters lien Profil Instagram
                  Charlotte Casters</a
                >
              </li>
            </ul>
          </div>
          <div class="col co--projects">
            <div class="footer-infos-projects">
              Mes domaines d’intervention : Animation (2) Démarche UX (6)
              Développement front-end (12) Direction artistique (30) Emailing
              (1) Illustration (14) Ingénierie pédagogique (5) Motion Design (4)
              Photographie (2) Scénographie (1) Story boarding (6) Wedesign (16)
              Les clients : Cegos DECATHLON Knowledge-Players ENGIE Cofely
              Société Générale Association des Sapeurs-Pompier Manpower SUBEA
              Sapeur-pompiers Cabinet de Sophrologie Les Horizons ENGIE
              Association Recyclarte Areva Groupama Korda & Partners EDHEC
              Dassault System Saint Gobain Cofely Ineo Isover Hygge Association
              Txikiekin Concorde Musée de l'Air et de l'Espace Marine Nationale
              SFR
            </div>
          </div>
          <div class="col col--search">
            <div class="footer-search">Rechercher :</div>
          </div>
        </aside>
      </div>

      <div class="bottom-footer">
        Tatziki par Charlotte Casters. 🌊🦄🏐🕯🖐🌴🌶✏️
      </div>
    </footer>

    <ScrollAnimator />
  </body>
</html>
<script>
  import { initBeforeAfter } from "../scripts/beforeAfter";
</script>

<style is:global></style>
