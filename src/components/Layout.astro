---
import '../styles/global.scss'; // ← Chemin relatif depuis le Layout
import ScrollAnimator from './projects/ScrollAnimator.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio Tatziki' } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title} | Tatziki</title>
  <!-- <link rel="stylesheet" href="/src/styles/global.scss"> -->
</head>
<body>
  <nav class="main-nav">
    <div class="logo-tatziki">
      <a href="/">Accueil</a>
    </div>
    <div class="main-nav-menu">
      <a href="/about">À propos</a>

    </div>
  </nav>
  
  <>
    <slot />
  </>
  
  <footer>
    <p>© {new Date().getFullYear()} Charlotte Casters | Tatziki</p>
  </footer>

  <ScrollAnimator />
</body>
</html>
<script>
  import { initBeforeAfter } from '../scripts/beforeAfter';
</script>

<style is:global></style>

