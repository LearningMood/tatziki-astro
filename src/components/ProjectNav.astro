---
import type { ProjectWithImages } from "@/lib/projectImages";

interface Props {
  prev: ProjectWithImages | null;
  next: ProjectWithImages | null;
}

const { prev, next } = Astro.props;
---

<nav aria-label="Navigation entre projets">
  <div class="container">
    <div class="project-nav">
      {prev ? (
        <a href={`/projets/${prev.id}`} class="project-nav__link project-nav__link--prev">
          {prev.thumb && (
            <picture class="project-nav__thumb">
              <source srcset={prev.thumb.avif} type="image/avif" />
              <source srcset={prev.thumb.webp} type="image/webp" />
              <img 
                src={prev.thumb.webp} 
                width={prev.thumb.width} 
                height={prev.thumb.height}
                alt=""
                loading="lazy"
              />
            </picture>
            <span class="project-nav__label">Projet précédent</span>
          <h4 class="project-nav__title">{prev.data.client}</h4>
          )}
        </a>
      ) : (
        <div class="project-nav__link project-nav__link--empty"></div>
      )}

      <a href="/" class="project-nav__home">
        Tous les projets
      </a>

      {next ? (
        <a href={`/projets/${next.id}`} class="project-nav__link project-nav__link--next">
          {next.thumb && (
            <picture class="project-nav__thumb">
              <source srcset={next.thumb.avif} type="image/avif" />
              <source srcset={next.thumb.webp} type="image/webp" />
              <img 
                  src={next.thumb.webp} 
                  width={next.thumb.width} 
                height={next.thumb.height}
                alt=""
                loading="lazy"
              />
            </picture>
            <span class="project-nav__label">Projet suivant</span>
            <h4 class="project-nav__title">{next.data.client}</h4>
          )}
        </a>
      ) : (
        <div class="project-nav__link project-nav__link--empty"></div>
      )}
      </div>
    </div>
</nav>
