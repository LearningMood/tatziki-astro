---
interface Props {
  content: string;
  col: number;
  span: number;
  top: string;
}

const { content, col, span, top } = Astro.props;
---

<blockquote
  class="gallery-text"
  style={`
    --col-start: ${col};
    --col-span: ${span};
    --margin-top: ${top};
  `}
>
  <p>{content}</p>
</blockquote>
