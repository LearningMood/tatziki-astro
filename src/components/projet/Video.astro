---
interface Props {
  src: string;
  col?: number;
  span?: number;
  top?: string;
  aspectRatio?: string;
  debug?: boolean;
  imageIndex?: number;
}

const { 
  src,
  col = 8,
  span = 6,
  top = "4vw",
  aspectRatio = "9/16",
  debug = false,
  imageIndex,
} = Astro.props;
---

<figure
  class="projet-item projet-item--video"
  style={`
    --col-start: ${col};
    --col-span: ${span};
    --margin-top: ${top};
    --aspect-ratio: ${aspectRatio};
  `}
>
  {debug && (
    <span class="debug-label debug-label--video">
      video après img {imageIndex} | col {col} span {span}
    </span>
  )}
  <video autoplay loop muted playsinline preload="metadata">
    <source src={`/videos/${src}.webm`} type="video/webm" />
    <source src={`/videos/${src}.mp4`} type="video/mp4" />
  </video>
</figure>

<style>
  .debug-label--video {
    position: absolute;
    top: 0;
    left: 0;
    background: rgba(0, 100, 255, 0.9);
    color: white;
    padding: 4px 8px;
    font-size: 11px;
    font-family: monospace;
    z-index: 100;
  }
</style>