---
import { Image } from "astro:assets";
import { fillerConfig } from "@/content/data-filler";
import FillerItem from "./FillerItem.astro";
import MasonryGridItem from "./MasonryGridItem.astro";
import Placeholder from "@/assets/tatziki-placeholder.jpg";

const { projects, miniProjects = [] } = Astro.props;

// Patterns pour projets principaux (sur 24 colonnes)
const mainPatterns = {
    feat: { cols: 12, rows: 9 },
    portrait: { cols: 8, rows: 10 },
    square: { cols: 6, rows: 6 }, //+2 pourle texte ?
    landscape: { cols: 12, rows: 7 },
    wide: { cols: 12, rows: 5 },
    tall: { cols: 6, rows: 12 },
    miniWide: { cols: 7, rows: 3 },
};

// Mini-projets de remplissage
const fillerPatterns = [
    { cols: 5, rows: 3 },
    { cols: 3, rows: 5 },
    { cols: 3, rows: 3 },
    { cols: 7, rows: 5 },
];

// Distribuer les projets principaux
const mainProjectsWithGrid = projects.map((project, index) => {
    const { title, thumbnailImage, couleur, categories } = project.data;
    //             ^^^^^^^^^^^^^^ Utilise le nouveau nom transformé

    const patterns = [
        "feat",
        "portrait",
        "square",
        "landscape",
        "wide",
        "tall",
        "miniWide",
    ];
    // quelle taille attribuer automatiquement si gridSize n'est pas défini dans le frontmatter. Le projet 0 aura "square", le projet 1 aura "wide", etc.
    // const gridSize = project.data.gridSize || patterns[index % patterns.length];

    // console.log("project.data", project.data);
    return {
        ...project, // Copie tout le projet original
        // gridSize, // Ajoute gridSize au niveau racine
        // gridSpan: mainPatterns[gridSize], // Ajoute gridSpan au niveau racine
        type: "projet",
    };
});

// Intercaler des mini-projets (environ 1 pour 3 principaux)
const allItems = [];
let fillerIndex = 0;

mainProjectsWithGrid.forEach((project, index) => {
    allItems.push({ ...project, type: "projet" });

    // Ajouter un filler tous les 3 projets
    if (index % 6 === 1 && fillerIndex < fillerConfig.items.length) {
        const pattern =
            fillerConfig.patterns[fillerIndex % fillerConfig.patterns.length];
        allItems.push({
            type: "filler",
            data: fillerConfig.items[fillerIndex],
            gridSpan: pattern,
        });
        fillerIndex++;
    }
});

// console.log('Projets:', allItems.filter(i => i.type === 'projet').length);
// console.log('Fillers:', allItems.filter(i => i.type === 'filler').length);
// console.log('Premier filler:', allItems.find(i => i.type === 'filler'));
---

<div class="masonry-grid">
    {
    allItems.map((item, index) => {
        if (item.type === "projet") {
            // 🔍 Debug
            console.log(`Projet ${index}:`, {
                slug: item.slug,
                hasData: !!item.data,
                hasThumbnail: !!item.data?.thumbnailImage,
                keys: Object.keys(item.data || {})
            });
            
            const { slug, data } = item;
            const { 
                title, 
                thumbnailImage, 
                couleur, 
                categories, 
                gridSize: gridSizeFromData 
            } = data;
            
            // ⚠️ Vérification temporaire
            if (!thumbnailImage) {
                console.error(`❌ Pas de thumbnail pour ${slug}`);
            }
            
            const gridSize = gridSizeFromData || patterns[index % patterns.length];
            const gridSpan = mainPatterns[gridSize];

            return (
                <MasonryGridItem 
                    title={title}
                    gridSize={gridSize}
                    cols={gridSpan.cols}
                    rows={gridSpan.rows}
                    couleur={couleur}
                    slug={slug}
                    thumbnail={thumbnailImage}
                    categories={categories}
                    index={index}
                />
            );
        }
        
        return (
            <FillerItem
                filler={item.data}
                gridSpan={item.gridSpan}
                delay={(index % 10) * 0.1}
            />
        );
    })
}
</div>

<script>
    // Animation au scroll (même que précédemment)
    const animateOnScroll = () => {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.1, rootMargin: "50px" },
        );

        document.querySelectorAll("[data-scroll-animate]").forEach((el) => {
            observer.observe(el);
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", animateOnScroll);
    } else {
        animateOnScroll();
    }
</script>
