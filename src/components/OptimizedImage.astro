const {
  src, 
  alt, 
  cols = 12, 
  parallax = 0, 
  loading = 'lazy',
  class: className = ''
} = Astro.props;

// Générer plusieurs formats et tailles
const widths = [400, 800, 1200, 1600];
const formats = ['avif', 'webp', 'jpg'];

