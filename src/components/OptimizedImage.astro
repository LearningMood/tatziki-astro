<div 
  class={`grid-item col-span-${cols} ${className}`}
  data-parallax={parallax}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    formats={formats}
    loading={loading}
    decoding="async"
    quality={80}
    class="w-full h-auto"
  />
</div>