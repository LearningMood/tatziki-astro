<script>
  class ScrollAnimator {
    constructor() {
      this.initScrollAnimation();
      this.initParallax();
    }

    // === ANIMATION D'APPARITION AU SCROLL ===
    initScrollAnimation() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              requestAnimationFrame(() => {
                entry.target.classList.add("is-visible");
              });
              // Ne pas unobserve si l'élément a du parallax
              if (!entry.target.hasAttribute('data-parallax')) {
                observer.unobserve(entry.target);
              }
            }
          });
        },
        { threshold: 0.1, rootMargin: "50px" }
      );

      document.querySelectorAll("[data-scroll-animate]").forEach((el) => {
        observer.observe(el);
      });
    }

    // === PARALLAX AU SCROLL ===
    initParallax() {
      const parallaxItems = document.querySelectorAll('[data-parallax]');
      
      if (parallaxItems.length === 0) return;

      const updateParallax = () => {
        parallaxItems.forEach((item) => {
          const amplitude = parseFloat(item.dataset.parallax || '0');
          if (amplitude === 0) return;

          const rect = item.getBoundingClientRect();
          const windowHeight = window.innerHeight;
          
          // Calculer le progrès du scroll
          // 0 = élément en bas de l'écran, 1 = élément en haut de l'écran
          const scrollProgress = (windowHeight - rect.top) / (windowHeight + rect.height);
          const clampedProgress = Math.max(0, Math.min(1, scrollProgress));
          
          // Calculer l'offset basé sur l'amplitude
          const offset = amplitude * clampedProgress;
          
          // Appliquer le transform sur le contenu (data-parallax-content)
          const content = item.querySelector('[data-parallax-content]');
          if (content) {
            content.style.transform = `translateY(${offset}px)`;
          }
        });
      };

      // Écouter le scroll avec throttle pour la performance
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateParallax();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
      
      // Init au chargement
      updateParallax();
    }
  }

  // Auto-init
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      new ScrollAnimator();
    });
  } else {
    new ScrollAnimator();
  }
</script>

<style is:global>
  /* === ANIMATION D'APPARITION === */
  [data-scroll-animate] {
    opacity: 0;
    transform: translateY(40px);
    transition: 
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: var(--delay, 0s);
  }

  [data-scroll-animate].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* === PARALLAX === */
  [data-parallax] {
    overflow: hidden; /* Important pour que l'image ne déborde pas */
  }

  [data-parallax] [data-parallax-content] {
    will-change: transform;
    transition: transform 0.1s linear;
  }

  /* === VARIANTES D'ANIMATION === */
  [data-scroll-animate][data-animate-from="left"] {
    transform: translateX(-50px) translateY(0);
  }

  [data-scroll-animate][data-animate-from="left"].is-visible {
    transform: translateX(0) translateY(0);
  }

  [data-scroll-animate][data-animate-from="right"] {
    transform: translateX(50px) translateY(0);
  }

  [data-scroll-animate][data-animate-from="right"].is-visible {
    transform: translateX(0) translateY(0);
  }

  [data-scroll-animate][data-animate-scale] {
    transform: scale(0.95) translateY(20px);
  }

  [data-scroll-animate][data-animate-scale].is-visible {
    transform: scale(1) translateY(0);
  }
</style>