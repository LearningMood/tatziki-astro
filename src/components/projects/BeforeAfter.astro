---
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt?: string;
}

const { before, after, alt = 'Comparaison avant/après' } = Astro.props;
---

<div class="before-after-container">
  <div class="before-after-images">
    <div class="image-before">
      <Image src={before} alt={`Avant - ${alt}`} />
      <span class="label">Avant</span>
    </div>
    <div class="image-after">
      <Image src={after} alt={`Après - ${alt}`} />
      <span class="label">Après</span>
    </div>
  </div>
</div>

<style>
  .before-after-container {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }

  .before-after-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .image-before,
  .image-after {
    position: relative;
  }

  .image-before img,
  .image-after img {
    width: 100%;
    height: auto;
    display: block;
  }

  .label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .before-after-images {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>