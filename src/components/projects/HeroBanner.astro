---
const { image, title, categories, description } = Astro.props;
---

<header class="project-header">
  <div class="container">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    {
      categories && (
        <div class="bloc-categories">
          {categories.map((cat) => (
            <span class="tax tax--category">{cat}</span>
          ))}
        </div>
      )
    }
  </div>
</header>

<div class="hero-banner" data-parallax>
  <div class="hero-image">
    <img src={image} alt={title} />
  </div>
