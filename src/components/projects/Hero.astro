---
import { Image } from "astro:assets";
import ScrollIcon from "../../components/graphics/ScrollIcon.astro";

import type { ImageMetadata } from "astro";

interface Props {
    imgSrc: ImageMetadata;
    title: string;
    categories?: string[];
    subtitle?: string;
    showScrollIndicator?: boolean;
    height?: "small" | "medium" | "full";
}

const {
    imgSrc,
    title,
    categories = [],
    subtitle,
    showScrollIndicator = true,
    height = "medium",
} = Astro.props;
---

<div class="container">
    <h1 class="project-title">{title}</h1>
</div>
<section class={`hero hero-${height}`} aria-labelledby="hero-title">
    <div
        class="hero-image"
        role="img"
        aria-label={`Illustration du projet ${title}`}
        data-parallax
    >
        <Image
            src={imgSrc}
            alt={`image du projet ${title}`}
            widths={[768, 1280, 1920, 2560]}
            sizes="100vw"
            formats={["avif", "webp", "jpeg"]}
            quality={80}
            loading="eager"
            fetchpriority="high"
        />
    </div>

    <div class="hero-overlay">
        <div class="hero-content">
            {
                categories && categories.length > 0 && (
                    <p class="hero-categories">{categories.join(" • ")}</p>
                )
            }
        </div>
    </div>
    <div class="scroll-indicator">
        <span>Défiler</span>
        <ScrollIcon />
    </div>
</section>
