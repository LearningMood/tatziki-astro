---
import { Image } from "astro:assets";
import ScrollIcon from "../../components/graphics/ScrollIcon.astro";

import type { ImageMetadata } from 'astro';

interface Props {
  imgSrc: ImageMetadata;
  title: string;
  categories?: string[];
  subtitle?: string;
  showScrollIndicator?: boolean;
  height?: 'small' | 'medium' | 'full';
}

const { 
  imgSrc, 
  title, 
  categories = [],
  subtitle,
  showScrollIndicator = true,
  height = 'medium'
} = Astro.props;

---
<div class="container">
    <h1 class="project-title">{title}</h1>
</div>
<section class={`hero-fullscreen hero-${height}`} aria-labelledby="hero-title">
    <div class="hero-image" role="img" aria-label={`Illustration du projet ${title}`} data-parallax>
        <Image
        src={imgSrc}
        alt=""
        widths={[1200, 1600, 2000, 2400]}
        formats={["avif", "webp", "jpg"]}
        loading="eager"
        quality={90}
        />
    </div>

    <div class="hero-overlay">
        <div class="hero-content">
            {
                categories && categories.length > 0 && (
                    <p class="hero-categories">{categories.join(" • ")}</p>
                )
            }
        </div>
    </div>
    <div class="scroll-indicator">
        <span>Défiler</span>
        <ScrollIcon />
    </div>
</section>
