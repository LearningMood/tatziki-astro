---
import { Image } from 'astro:assets';

interface Props {
  projects: Array<{
    slug: string;
    data: {
      title: string;
      description?: string;
      categories: string[];
      heroImage: any;
      thumbnail_alt?: string;
      color: string;
    };
  }>;
}
const { projects } = Astro.props;
---

<section class="carousel">

  <div class="carousel-container">
    <div class="carousel-track">
      {projects.map((project, index) => (
        <div class="carousel-slide" id={`slide-${index}`}>
          <a href={`/projects/${project.slug}`} class="carousel-featured-card ">
            {project.data.heroImage && (
              <div class="featured-image">
                <Image
                  src={project.data.heroImage}
                  alt={project.data.thumbnail_alt || project.data.title}
                  widths={[640, 1024, 1600, 2400]}
                  sizes="100vw"
                  formats={['avif','webp','jpeg']}
                  quality={80} 
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
              <div class="bandeau-overlay"></div>
            )}
            <div class="featured-infos">
              {project.data.title && (
              <h3
                style={`
                  --color: ${project.data.couleur || "#3085a3"};`}
              >{project.data.title}</h3>
              )}
              <div class="featured-categories">
                {project.data.categories.slice(0, 2).map(cat => (
                  <span class="category-tag">{cat}</span>
                ))}
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
  <!-- Navigation par points -->
<div class="carousel-nav">
  {projects.map((_, index) => (
   <button 
            class="nav-dot"
            data-slide={index}
            aria-label={`Aller au projet ${index + 1}`}
            type="button"
          />
  ))}
</div>
</section>



<script>
  function initCarouselNav() {
    const container = document.querySelector('.carousel-container');
    const track = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.nav-dot');
    
    if (!track || slides.length === 0) return;
    
    function goToSlide(index) {
      const slide = slides[index];
      if (!slide) return;
      
      // Calculer la position exacte
      const slideLeft = slide.offsetLeft;
      
      // Scroll horizontal uniquement, sans toucher au scroll vertical
      track.scrollTo({
        left: slideLeft,
        behavior: 'smooth'
      });
      
      updateDots(index);
    }
    
    function updateDots(activeIndex) {
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === activeIndex);
      });
    }
    
    // Click sur les dots
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault(); // ← Empêche tout comportement par défaut
        const slideIndex = parseInt(dot.dataset.slide);
        goToSlide(slideIndex);
      });
    });
    
    // Détecter la slide visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            const index = Array.from(slides).indexOf(entry.target);
            updateDots(index);
          }
        });
      },
      { 
        threshold: 0.5, 
        root: track 
      }
    );
    
    slides.forEach((slide) => observer.observe(slide));
    
    updateDots(0);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarouselNav);
  } else {
    initCarouselNav();
  }
</script>