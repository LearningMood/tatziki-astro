---
import { Image } from 'astro:assets';

interface Props {
  projects: Array<{
    slug: string;
    data: {
      title: string;
      description?: string;
      categories: string[];
      heroImage: any;
      thumbnail_alt?: string;
      color: string;
    };
  }>;
}
const { projects } = Astro.props;
---

<div class="featured-section">

    <div class="carousel-container">
      <div class="carousel-track">
        {projects.map((project, index) => (
          <div class="carousel-slide" id={`slide-${index}`}>
            <a href={`/projects/${project.slug}`} class="featured-card">
              {project.data.heroImage && (
                <div class="featured-image">
                  <Image
                    src={project.data.heroImage}
                    alt={project.data.thumbnail_alt || project.data.title}
                    widths={[600, 900, 1200]}
                    formats={['avif', 'webp', 'jpg']}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    quality={85}
                  />
                </div>
                <div class="bandeau-overlay"></div>
              )}
              <div class="featured-infos">
                {project.data.title && (
                <h3
                  style={`
                    --color: ${project.data.couleur || "#3085a3"};`}
                >{project.data.title}</h3>
                )}
                <div class="featured-categories">
                  {project.data.categories.slice(0, 2).map(cat => (
                    <span class="category-tag">{cat}</span>
                  ))}
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
    <!-- Navigation par points -->
      <div class="carousel-nav">
        {projects.map((_, index) => (
          <a 
            href={`#slide-${index}`} 
            class="nav-dot"
            aria-label={`Aller au projet ${index + 1}`}
          />
        ))}
      </div>
</div>

<script>
  function initCarousel() {
    const track = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    let currentIndex = 0;
    const intervalTime = 5000;
    
    function goToSlide(index) {
      slides[index]?.scrollIntoView({ 
        behavior: 'smooth', 
        block: 'nearest', 
        inline: 'center' 
      });
    }
    
    function nextSlide() {
      currentIndex = (currentIndex + 1) % slides.length;
      goToSlide(currentIndex);
    }
    
    // Auto-play
    let interval = setInterval(nextSlide, intervalTime);
    
    // Pause au hover
    track?.addEventListener('mouseenter', () => {
      clearInterval(interval);
    });
    
    track?.addEventListener('mouseleave', () => {
      interval = setInterval(nextSlide, intervalTime);
    });
    
    // Cleanup
    document.addEventListener('astro:before-swap', () => {
      clearInterval(interval);
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
</script>